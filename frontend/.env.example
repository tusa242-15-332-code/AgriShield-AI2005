# FastAPI base URL. Keep localhost for local demo; set to deployed API URL in production.
VITE_API_BASE_URL=http://localhost:8000

# Optional Firebase config. Without these values, the existing app's demo/local
# fallback remains active. Never put private server credentials in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
